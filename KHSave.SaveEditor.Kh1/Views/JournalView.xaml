<UserControl x:Class="KHSave.SaveEditor.Kh1.Views.JournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="400">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock TextWrapping="Wrap">
            KH1 Final Mix stores some Journal entries as hidden flags separate from
            the normal inventory and reward tables. Toggle these entries to repair
            patched saves that missed the original reward trigger.
        </TextBlock>

        <DataGrid
            Grid.Row="2"
            AutoGenerateColumns="False"
            Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            ItemsSource="{Binding Heartless}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Header="Heartless"
                    Width="*"
                    IsReadOnly="True"
                    Binding="{Binding Name}"/>
                <DataGridCheckBoxColumn
                    Header="Complete In Journal"
                    Width="Auto"
                    Binding="{Binding IsVisible, UpdateSourceTrigger=PropertyChanged}"/>
            </DataGrid.Columns>
        </DataGrid>

        <DataGrid
            Grid.Row="4"
            AutoGenerateColumns="False"
            Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            ItemsSource="{Binding Reports}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Header="Report"
                    Width="*"
                    IsReadOnly="True"
                    Binding="{Binding Name}"/>
                <DataGridCheckBoxColumn
                    Header="Visible In Journal"
                    Width="Auto"
                    Binding="{Binding IsVisible, UpdateSourceTrigger=PropertyChanged}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
